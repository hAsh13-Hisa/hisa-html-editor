{
  "name": "Hisa HTML Editor",
  "description": "ローカルのHTMLファイルを編集・プレビューできるシンプルなエディタ",
  "version": "1.1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "HTMLエディタを開く",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
